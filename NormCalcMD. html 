<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Výpočet práce na dávce</title>
<style>
  :root{
    --bg:#12161c;
    --panel:#1b2129;
    --panel2:#232b35;
    --line:#2c3542;
    --ink:#e8ecf1;
    --dim:#8b97a6;
    --accent:#5fb8a8;
    --warn:#e0a458;
    --err:#e07070;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Segoe UI', Roboto, system-ui, sans-serif;
    -webkit-tap-highlight-color:transparent;
  }
  .wrap{
    max-width:480px;
    margin:0 auto;
    padding:20px 18px 60px;
  }
  h1{
    font-size:1.3rem;
    font-weight:700;
    letter-spacing:0.02em;
    margin:6px 0 2px;
  }
  .sub{
    color:var(--dim);
    font-size:0.85rem;
    margin-bottom:22px;
  }
  .card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:14px;
    padding:16px;
    margin-bottom:14px;
  }
  .card h2{
    font-size:0.72rem;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:var(--accent);
    margin:0 0 12px;
  }
  label{
    display:block;
    font-size:0.85rem;
    color:var(--dim);
    margin:10px 0 6px;
  }
  label:first-of-type{margin-top:0;}
  input{
    width:100%;
    background:var(--panel2);
    border:1px solid var(--line);
    border-radius:10px;
    padding:12px 12px;
    color:var(--ink);
    font-size:1rem;
    outline:none;
  }
  input:focus{
    border-color:var(--accent);
  }
  .hint{
    color:var(--dim);
    font-size:0.75rem;
    margin-top:4px;
  }
  button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:12px;
    background:var(--accent);
    color:#0d1a17;
    font-size:1rem;
    font-weight:700;
    letter-spacing:0.01em;
    margin-top:6px;
  }
  button.secondary{
    background:transparent;
    color:var(--dim);
    border:1px solid var(--line);
    font-weight:600;
    margin-top:10px;
  }
  .result-row{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    padding:8px 0;
    border-bottom:1px solid var(--line);
  }
  .result-row:last-child{border-bottom:none;}
  .result-row .k{color:var(--dim); font-size:0.85rem;}
  .result-row .v{font-size:1.15rem; font-weight:700;}
  .result-row .v.big{color:var(--accent); font-size:1.4rem;}
  .msg{
    padding:12px;
    border-radius:10px;
    font-size:0.9rem;
    margin-top:4px;
  }
  .msg.err{background:rgba(224,112,112,0.12); color:var(--err); border:1px solid rgba(224,112,112,0.3);}
  .msg.warn{background:rgba(224,164,88,0.12); color:var(--warn); border:1px solid rgba(224,164,88,0.3);}
  #resultCard{display:none;}
</style>
</head>
<body>
<div class="wrap">
  <h1>Výpočet práce na dávce</h1>
  <div class="sub">12hodinové směny, ranní a noční přestávky</div>

  <div class="card">
    <h2>Výroba</h2>
    <label for="norma">Norma za hodinu</label>
    <input id="norma" type="number" inputmode="decimal" placeholder="např. 25">

    <label for="pocet">Počet vyrobených kusů</label>
    <input id="pocet" type="number" inputmode="numeric" placeholder="např. 150">
  </div>

  <div class="card">
    <h2>Čas</h2>
    <label for="start">Začátek práce na dávce</label>
    <input id="start" type="text" placeholder="např. 6:00">
    <div class="hint">Přestávky: ranní 10:05–10:35 a 15:05–15:35, noční 22:35–23:05 a 03:05–03:35.</div>
  </div>

  <button id="calcBtn">Vypočítat</button>
  <button id="resetBtn" class="secondary">Nový výpočet</button>

  <div class="card" id="resultCard"></div>
</div>

<script>
const BREAKS = [
  {h:10, mi:5},
  {h:15, mi:5},
  {h:22, mi:35},
  {h:3, mi:5}
];
const BREAK_LEN = 30;

function toColon(s){
  s = s.trim();
  ['.','-',',',' '].forEach(sym => { s = s.split(sym).join(':'); });
  return s;
}

function parseHM(s){
  const m = s.match(/^(\d{1,2}):(\d{1,2})$/);
  if(!m) return null;
  const h = parseInt(m[1],10), mi = parseInt(m[2],10);
  if(h>23 || mi>59) return null;
  return {h, mi};
}

function toDate(hm){
  return new Date(2000,0,1,hm.h,hm.mi,0,0);
}

function fmt(d){
  const h = d.getHours().toString().padStart(2,'0');
  const m = d.getMinutes().toString().padStart(2,'0');
  return `${h}:${m}`;
}

function addMin(d, mins){
  return new Date(d.getTime() + mins*60000);
}

function renderResult(rows){
  const card = document.getElementById('resultCard');
  card.innerHTML = '<h2>Výsledek</h2>' + rows.join('');
  card.style.display = 'block';
}

document.getElementById('calcBtn').addEventListener('click', () => {
  const rows = [];

  const normaRaw = document.getElementById('norma').value;
  const pocetRaw = document.getElementById('pocet').value;
  const startRaw = toColon(document.getElementById('start').value);

  if(normaRaw === '' || pocetRaw === '' || !startRaw){
    renderResult([`<div class="msg err">Vyplňte normu, počet kusů i začátek práce.</div>`]);
    return;
  }

  const norma = parseFloat(normaRaw.replace(',', '.'));
  const pocet = parseFloat(pocetRaw.replace(',', '.'));

  if(!norma || norma <= 0){
    renderResult([`<div class="msg err">Norma musí být kladné číslo.</div>`]);
    return;
  }

  const startHM = parseHM(startRaw);
  if(!startHM){
    renderResult([`<div class="msg err">Neplatný formát začátku (použijte HH:MM).</div>`]);
    return;
  }

  const timeH = pocet / norma;
  let minutes = Math.round((timeH * 60) / 10) * 10;
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  rows.push(`<div class="result-row"><span class="k">Čas práce na dávce</span><span class="v big">${hours}:${mins.toString().padStart(2,'0')}</span></div>`);

  const start = toDate(startHM);
  let end = addMin(start, minutes);

  const startOfDay = startHM.h*60 + startHM.mi;
  const breakDates = BREAKS.map(b => {
    let d = toDate(b);
    const brOfDay = b.h*60 + b.mi;
    if(brOfDay < startOfDay){
      d = new Date(d.getTime() + 24*60*60000);
    }
    return d;
  }).sort((a,b) => a - b);

  breakDates.forEach(bd => {
    if(start <= bd && bd < end){
      end = addMin(end, BREAK_LEN);
    }
  });

  rows.push(`<div class="result-row"><span class="k">Konec práce na dávce</span><span class="v big">${fmt(end)}</span></div>`);

  renderResult(rows);
});

document.getElementById('resetBtn').addEventListener('click', () => {
  document.getElementById('norma').value = '';
  document.getElementById('pocet').value = '';
  document.getElementById('start').value = '';
  document.getElementById('resultCard').style.display = 'none';
});
</script>
</body>
</html>
