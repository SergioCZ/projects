<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Výpočet směny</title>
<style>
  :root{
    --bg:#12161c;
    --panel:#1b2129;
    --panel2:#232b35;
    --line:#2c3542;
    --ink:#e8ecf1;
    --dim:#8b97a6;
    --accent:#5fb8a8;
    --warn:#e0a458;
    --err:#e07070;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Segoe UI', Roboto, system-ui, sans-serif;
    -webkit-tap-highlight-color:transparent;
  }
  .wrap{
    max-width:480px;
    margin:0 auto;
    padding:20px 18px 60px;
  }
  h1{
    font-size:1.3rem;
    font-weight:700;
    letter-spacing:0.02em;
    margin:6px 0 2px;
  }
  .sub{
    color:var(--dim);
    font-size:0.85rem;
    margin-bottom:22px;
  }
  .card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:14px;
    padding:16px;
    margin-bottom:14px;
  }
  .card h2{
    font-size:0.72rem;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:var(--accent);
    margin:0 0 12px;
  }
  label{
    display:block;
    font-size:0.85rem;
    color:var(--dim);
    margin:10px 0 6px;
  }
  label:first-of-type{margin-top:0;}
  input{
    width:100%;
    background:var(--panel2);
    border:1px solid var(--line);
    border-radius:10px;
    padding:12px 12px;
    color:var(--ink);
    font-size:1rem;
    outline:none;
  }
  input:focus{
    border-color:var(--accent);
  }
  .hint{
    color:var(--dim);
    font-size:0.75rem;
    margin-top:4px;
  }
  button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:12px;
    background:var(--accent);
    color:#0d1a17;
    font-size:1rem;
    font-weight:700;
    letter-spacing:0.01em;
    margin-top:6px;
  }
  button.secondary{
    background:transparent;
    color:var(--dim);
    border:1px solid var(--line);
    font-weight:600;
    margin-top:10px;
  }
  .result-row{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    padding:8px 0;
    border-bottom:1px solid var(--line);
  }
  .result-row:last-child{border-bottom:none;}
  .result-row .k{color:var(--dim); font-size:0.85rem;}
  .result-row .v{font-size:1.15rem; font-weight:700;}
  .result-row .v.big{color:var(--accent); font-size:1.4rem;}
  .msg{
    padding:12px;
    border-radius:10px;
    font-size:0.9rem;
    margin-top:4px;
  }
  .msg.err{background:rgba(224,112,112,0.12); color:var(--err); border:1px solid rgba(224,112,112,0.3);}
  .msg.warn{background:rgba(224,164,88,0.12); color:var(--warn); border:1px solid rgba(224,164,88,0.3);}
  #resultCard{display:none;}
</style>
</head>
<body>
<div class="wrap">
  <h1>Výpočet směny</h1>
  <div class="sub">Norma, čas práce a začátek/konec</div>

  <div class="card">
    <h2>Norma</h2>
    <label for="norma">Norma na směnu</label>
    <input id="norma" type="number" inputmode="numeric" placeholder="např. 480">

    <label for="udelano">Kolik uděláno</label>
    <input id="udelano" type="number" inputmode="numeric" placeholder="např. 320">
  </div>

  <div class="card">
    <h2>Čas</h2>
    <label for="start">Začátek práce</label>
    <input id="start" type="text" inputmode="numeric" placeholder="např. 6:00 (nechte prázdné, pokud znáte konec)">

    <label for="end">Konec práce</label>
    <input id="end" type="text" inputmode="numeric" placeholder="např. 14:30 (nechte prázdné, pokud znáte začátek)">
    <div class="hint">Vyplňte pouze jeden z těchto dvou časů.</div>
  </div>

  <button id="calcBtn">Vypočítat</button>
  <button id="resetBtn" class="secondary">Nový výpočet</button>

  <div class="card" id="resultCard"></div>
</div>

<script>
function toColon(s){
  s = s.trim();
  ['.','-',',',' '].forEach(sym => { s = s.split(sym).join(':'); });
  return s;
}

function parseHM(s){
  const m = s.match(/^(\d{1,2}):(\d{1,2})$/);
  if(!m) return null;
  const h = parseInt(m[1],10), mi = parseInt(m[2],10);
  if(h>23 || mi>59) return null;
  return {h, mi};
}

function toDate(hm){
  return new Date(2000,0,1,hm.h,hm.mi,0,0);
}

function fmt(d){
  const h = d.getHours().toString().padStart(2,'0');
  const m = d.getMinutes().toString().padStart(2,'0');
  return `${h}:${m}`;
}

function addMin(d, mins){
  return new Date(d.getTime() + mins*60000);
}

function renderResult(rows){
  const card = document.getElementById('resultCard');
  card.innerHTML = '<h2>Výsledek</h2>' + rows.join('');
  card.style.display = 'block';
}

document.getElementById('calcBtn').addEventListener('click', () => {
  const rows = [];

  const normsRaw = document.getElementById('norma').value;
  const udelanoRaw = document.getElementById('udelano').value;

  if(normsRaw === '' || udelanoRaw === ''){
    renderResult([`<div class="msg err">Vyplňte normu i uděláno.</div>`]);
    return;
  }

  const norms = parseInt(normsRaw, 10);
  const udelano = parseInt(udelanoRaw, 10);

  const normh = norms / 7.5;
  rows.push(`<div class="result-row"><span class="k">Norma na hodinu</span><span class="v">${normh.toFixed(2)}</span></div>`);

  const timep = udelano / normh;
  const minutes = Math.round((timep * 60 / 10)) * 10;
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  rows.push(`<div class="result-row"><span class="k">Čas práce</span><span class="v big">${hours}:${mins.toString().padStart(2,'0')}</span></div>`);

  let startRaw = toColon(document.getElementById('start').value);
  let endRaw = toColon(document.getElementById('end').value);

  if(startRaw && endRaw){
    rows.push(`<div class="msg err">Zadejte pouze jeden čas (začátek nebo konec).</div>`);
    renderResult(rows);
    return;
  }
  if(!startRaw && !endRaw){
    rows.push(`<div class="msg warn">Nezadali jste žádný čas.</div>`);
    renderResult(rows);
    return;
  }

  if(startRaw){
    const startHM = parseHM(startRaw);
    if(!startHM){
      rows.push(`<div class="msg err">Neplatný formát začátku (použijte HH:MM).</div>`);
      renderResult(rows);
      return;
    }
    const start = toDate(startHM);
    let end = addMin(start, minutes);

    let break02 = toDate({h:2, mi:0});
    if(start.getHours() >= 2){
      break02 = new Date(break02.getTime() + 24*60*60000);
    }
    if(start <= break02 && break02 < end){ end = addMin(end, 30); }

    const break10 = toDate({h:10, mi:0});
    if(start <= break10 && break10 < end){ end = addMin(end, 30); }

    const break18 = toDate({h:18, mi:0});
    if(start <= break18 && break18 < end){ end = addMin(end, 30); }

    rows.push(`<div class="result-row"><span class="k">Konec práce</span><span class="v big">${fmt(end)}</span></div>`);
  } else {
    const endHM = parseHM(endRaw);
    if(!endHM){
      rows.push(`<div class="msg err">Neplatný formát konce (použijte HH:MM).</div>`);
      renderResult(rows);
      return;
    }
    const end = toDate(endHM);
    let start = addMin(end, -minutes);

    const break02 = toDate({h:2, mi:0});
    if(start <= break02 && break02 < end){ start = addMin(start, -30); }

    const break10 = toDate({h:10, mi:0});
    if(start <= break10 && break10 < end){ start = addMin(start, -30); }

    const break18 = toDate({h:18, mi:0});
    if(start <= break18 && break18 < end){ start = addMin(start, -30); }

    rows.push(`<div class="result-row"><span class="k">Začátek práce</span><span class="v big">${fmt(start)}</span></div>`);
  }

  renderResult(rows);
});

document.getElementById('resetBtn').addEventListener('click', () => {
  document.getElementById('norma').value = '';
  document.getElementById('udelano').value = '';
  document.getElementById('start').value = '';
  document.getElementById('end').value = '';
  document.getElementById('resultCard').style.display = 'none';
});
</script>
</body>
</html>
